---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import EntryList from '../../components/EntryList.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import { getExperience } from '$lib/content';
import type { ExperienceEntry } from '$lib/types/experienceEntry';

const title = "Where I've worked and what I built";
const description =
	'Product roles across climate tech and energy, one failed startup, podcasts, an NGO, and a lot of iteration on what good product work actually looks like.';

const experienceEntries = await getExperience();

// Current = any position with endDate === null; past sorted by most recent start date.
const latestStart = (entry: ExperienceEntry): number =>
	Math.max(...entry.positions.map((position) => new Date(position.startDate).getTime()));
const cards = experienceEntries.map((entry) => ({
	entry,
	isCurrent: entry.positions.some((position) => position.endDate === null)
}));
// There can be more than one current role (day job plus consulting) - feature all
// of them, or an entry silently disappears from the page.
const current = cards
	.filter((card) => card.isCurrent)
	.sort((a, b) => latestStart(b.entry) - latestStart(a.entry));
const past = cards
	.filter((card) => !card.isCurrent)
	.sort((a, b) => latestStart(b.entry) - latestStart(a.entry));
---

<Layout title={title} description={description}>
	<Hero slot="hero" title={title} description={description} />
	<div class="experience-container">
		{current.map((card) => <ExperienceCard entry={card.entry} featured class="golden-ratio" />)}
		{
			past.length > 0 && (
				<EntryList columns={2}>
					{past.map((card) => (
						<li>
							<ExperienceCard entry={card.entry} />
						</li>
					))}
				</EntryList>
			)
		}
	</div>
</Layout>

<style>
	.experience-container {
		display: flex;
		margin-inline: auto;
		width: 100%;
		max-width: var(--layout-xl);
		flex-direction: column;
		gap: var(--xl);
	}
</style>
